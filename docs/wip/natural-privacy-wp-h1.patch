+        cols = list(rows[0])
+        types = [pa.int64() if isinstance(rows[0][c], int) else pa.string() for c in cols]
+        schema = pa.schema(list(zip(cols, types, strict=True)))
+        pq.write_table(pa.table({c: [r[c] for r in rows] for c in cols}, schema=schema), data / f"{name}.parquet")
+    s9, s9x = tmp_path / "s9.json", tmp_path / "s9x.json"
+    s9.write_text(json.dumps({"sample": {"rows": [{"comment_id": 100}]}}))
+    s9x.write_text(json.dumps({"rows": [{"comment_id": 200}]}))
+    assert scan.aidev_logins(data, s9) == ["fx-rev-s9"]
+    both = ["fx-committer-s9x", "fx-hub-org", "fx-issue-s9x", "fx-rev-s9", "fx-rev-s9x"]
+    assert scan.aidev_logins(data, s9, s9x) == both  # the owner fx-hub-org acts as an account (PR 3)
+    monkeypatch.setattr(scan, "NOT_PEOPLE", {hashlib.sha256(b"fx-hub-org").hexdigest(): "an organisation (fixture)"})
+    assert scan.aidev_logins(data, s9, s9x) == [x for x in both if x != "fx-hub-org"]
+    # By default both screening manifests of the repository are read: the 150 comments of S9 and the 534 of S9x.
+    assert scan.AIDEV_MANIFESTS == (scan.AIDEV_MANIFEST, scan.AIDEV_EXTENSION_MANIFEST)
+    ids = scan.sampled_comment_ids()
+    assert len(ids) == len(set(ids)) == 684
