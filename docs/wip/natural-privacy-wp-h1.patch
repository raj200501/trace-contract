+    events = [("issue", "human", NP91_ISSUE), ("commit/1", "agent", "Initial plan"), ("commit/2", "agent", AGENT_SHORT),
+              ("review/1", "human", CJK_SHORT), ("reply/1", "human", LIST_TEXT), ("reply/2", "human", CJK_TEXT),
