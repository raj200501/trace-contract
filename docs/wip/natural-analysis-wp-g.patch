+POOLED_KEYS = {"ci95", "exact95", "macro", "rate", "youden_j", "signflip", "p_greater", "p_two_sided", "floor_two_sided",
+               "false_acceptance", "false_rejection", "bootstrap", "pooled", "difference", "per_task_rates"}
