+def _keys(x) -> set[str]:
+    """Every dict key anywhere in ``x``."""
+    if isinstance(x, dict):
+        return {k for k in x} | {k2 for k, v in x.items() for k2 in _keys(v)}
+    if isinstance(x, list):
+        return {k for v in x for k in _keys(v)}
+    return set()
+
