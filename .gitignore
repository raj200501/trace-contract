# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Raw or sensitive inputs never committed (see docs/data_card.md)
data/raw/
data/gated/
data/natural/
*.parquet
# Natural PR-review material outside data/natural/ (protocol §17.4): a natural task under tasks/, and a natural run's
# private results and report under results/runs/ (the publication tool, kept as a patch in docs/wip/, is to publish only
# the shareable files)
tasks/NP-*/
results/runs/natural-*/results.jsonl
results/runs/natural-*/report.html

# Large or regenerable artifacts
results/runs/*/logs/
/snapshots/
paper/build/
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.run.xml
paper/*.synctex.gz
paper/*.toc
paper/main.pdf
paper/*-SAVE-ERROR
